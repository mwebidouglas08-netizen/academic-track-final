# ── Copy this to .env and fill in your values ──

# PostgreSQL connection string from Railway
DATABASE_URL=postgresql://user:password@host:port/database

# JWT secret — use a long random string in production
JWT_SECRET=your_super_secret_jwt_key_change_this

# Node environment
NODE_ENV=production

# Port (Railway sets this automatically)
PORT=5000

# Allowed origins for CORS (comma-separated, no spaces)
# Set to your Railway frontend URL after deployment
ALLOWED_ORIGINS=https://your-app.railway.app,http://localhost:3000
